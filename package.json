{
  "name": "paradox",
  "version": "1.0.0",
  "description": "Production Discord Bot & Web Companion Dashboard",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:bot": "node index.js",
    "bot": "node index.js",
    "build:bot": "esbuild src/bot/index.ts --bundle --platform=node --target=node20 --outfile=dist/bot.js --external:discord.js --external:@prisma/client --external:dotenv",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "web:install": "npm install next@14.2.15 react@18.3.1 react-dom@18.3.1 lucide-react@0.453.0 cookie@0.7.2 jsonwebtoken@9.0.2 tailwindcss@3.4.14 postcss@8.4.47 autoprefixer@10.4.20",
    "dev:web": "next dev",
    "build:web": "next build",
    "start:web": "next start",
    "test": "vitest run"
  },
  "dependencies": {
    "@discordjs/rest": "^2.4.0",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@prisma/client": "^5.21.1",
    "discord-api-types": "^0.37.100",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "prisma": "^5.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
