// Prisma schema for Discord Bot & Dashboard

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String    @id // Discord User ID
  username       String
  discriminator  String?
  avatar         String?
  accessToken    String?   // Encrypted/session token
  refreshToken   String?
  tokenExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model GuildConfig {
  id                       String         @id // Discord Guild ID
  name                     String
  icon                     String?
  botJoined                Boolean        @default(true)
  prefix                   String         @default("$")
  
  // Link to video fixer / embedder settings
  videoFixerEnabled        Boolean        @default(true)
  videoFixerProviders      String         @default("[\"twitter\",\"tiktok\",\"instagram\",\"reddit\",\"bluesky\",\"threads\"]") // JSON array
  videoFixerIgnoredChannels String        @default("[]") // JSON array of channel IDs
  videoFixerDeleteButton   Boolean        @default(true) // Auto-add 🗑️ dismiss button for message author

  // Welcome System
  welcomeEnabled           Boolean        @default(false)
  welcomeChannelId         String?
  welcomeMessage           String?        @default("Welcome to {server.name}, {user.mention}! 🎉 Check out {#rules} to get started.")
  welcomeEmbed             String?        // JSON of Embed
  welcomeDmEnabled         Boolean        @default(false)
  welcomeDmMessage         String?
  welcomeRoleId            String?        // Auto-role given on join

  // Goodbye System
  goodbyeEnabled           Boolean        @default(false)
  goodbyeChannelId         String?
  goodbyeMessage           String?        @default("{user.name} has left {server.name}. We now have {server.member_count} members.")
  goodbyeEmbed             String?

  reactionRoles            ReactionRole[]
  embedTemplates           EmbedTemplate[]
  auditLogs                AuditLog[]
  rules                    Rule[]
  announcements            Announcement[]
  events                   Event[]
  giveaways                Giveaway[]
  autoMessages             AutoMessage[]
  stickyMessages           StickyMessage[]

  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
}

model Rule {
  id          String      @id @default(cuid())
  guildId     String
  ruleNumber  Int         @default(1)
  title       String
  description String
  emoji       String?     @default("📌")
  section     String?     @default("General")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  guild       GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model Announcement {
  id            String      @id @default(cuid())
  guildId       String
  channelId     String
  title         String?
  content       String      @default("")
  embed         String?     // JSON
  mentionType   String      @default("NONE") // NONE, EVERYONE, HERE, ROLE
  mentionRoleId String?
  status        String      @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED
  scheduledAt   DateTime?
  publishedAt   DateTime?
  messageId     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  guild         GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model Event {
  id             String      @id @default(cuid())
  guildId        String
  channelId      String?
  title          String
  description    String?
  location       String?
  voiceChannelId String?
  imageUrl       String?
  startsAt       DateTime
  endsAt         DateTime?
  timeZone       String      @default("UTC")
  status         String      @default("SCHEDULED") // SCHEDULED, ACTIVE, COMPLETED, CANCELLED
  discordEventId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  guild          GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model Giveaway {
  id             String      @id @default(cuid())
  guildId        String
  channelId      String
  messageId      String?
  prize          String
  description    String?
  winnersCount   Int         @default(1)
  endsAt         DateTime
  status         String      @default("ACTIVE") // ACTIVE, ENDED, CANCELLED
  requiredRoleId String?
  winners        String      @default("[]") // JSON array of user IDs
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  guild          GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model AutoMessage {
  id              String      @id @default(cuid())
  guildId         String
  channelId       String
  name            String
  intervalMinutes Int         @default(60)
  content         String?
  embed           String?     // JSON
  enabled         Boolean     @default(true)
  lastSentAt      DateTime?
  nextRunAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  guild           GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model StickyMessage {
  id        String      @id @default(cuid())
  guildId   String
  channelId String      @unique
  messageId String?
  content   String?
  embed     String?     // JSON
  enabled   Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  guild     GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model ReactionRole {
  id          String      @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String
  emoji       String      // Unicode emoji or custom emoji string name:id
  roleId      String
  roleName    String
  description String?
  
  // Unique Visual & Interactive Features
  type        String      @default("REACTION") // "REACTION", "BUTTON", "SELECT_MENU"
  mode        String      @default("TOGGLE")   // "TOGGLE", "UNIQUE" (radio single-choice), "VERIFY" (one-time lock), "REVERSED"
  requiredRoleId String?  // Optional prerequisite role required to claim
  imageUrl    String?     // Custom badge image / GIF / sticker preview for this role
  bannerUrl   String?     // Header banner image or GIF for the panel
  confirmGif  String?     // Animated GIF or sticker image shown on claim/revoke
  buttonStyle String?     @default("PRIMARY") // PRIMARY, SECONDARY, SUCCESS, DANGER

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  guild       GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([guildId])
}

model EmbedTemplate {
  id                    String      @id @default(cuid())
  guildId               String
  name                  String      @default("Untitled Embed")
  title                 String?
  description           String?
  url                   String?
  color                 String?     @default("#5865F2")
  authorName            String?
  authorUrl             String?
  authorIconUrl         String?
  footerText            String?
  footerIconUrl         String?
  timestamp             Boolean     @default(false)
  thumbnailUrl          String?
  imageUrl              String?
  fields                String      @default("[]") // JSON array of { name: string, value: string, inline: boolean }
  lastPublishedChannelId String?
  lastPublishedMessageId String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  guild                 GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model AuditLog {
  id        String      @id @default(cuid())
  guildId   String
  userId    String
  action    String
  details   String?     // JSON description of changes
  createdAt DateTime    @default(now())

  guild     GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}
