# ==========================================
# Discord Application & Bot Credentials
# ==========================================
# Found under Discord Developer Portal -> General Information -> Application ID
DISCORD_CLIENT_ID="123456789012345678"
NEXT_PUBLIC_DISCORD_CLIENT_ID="123456789012345678"

# Found under Discord Developer Portal -> OAuth2 -> General -> Client Secret
DISCORD_CLIENT_SECRET="your_discord_client_secret_here"

# Found under Discord Developer Portal -> Bot -> Token
DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# OAuth2 Redirect URI (must be added in Discord Developer Portal -> OAuth2 -> Redirects)
# Format: {NEXT_PUBLIC_APP_URL}/api/auth/callback
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# Public application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# Security & Sessions
# ==========================================
# Secret key used for signing HTTP-only session JWT cookies. Generate using: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-very-secure-random-32-byte-string-for-production"

# ==========================================
# Database Configuration (Neon PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-jolly-fog-b4fy828z-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# Application Settings
# ==========================================
PORT=3000
NODE_ENV="development"
